1
00:00:00,000 --> 00:00:03,880
بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ

2
00:00:03,880 --> 00:00:08,860
ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِيٓ أَنزَلَ عَلَىٰ عَبۡدِهِ

3
00:00:08,860 --> 00:00:12,180
ٱلۡكِتَٰبَ وَلَمۡ يَجۡعَل لَّهُۥ عِوَجَاۜ ١

4
00:00:12,180 --> 00:00:18,860
قَيِّمٗا لِّيُنذِرَ بَأۡسٗا شَدِيدٗا مِّن لَّدُنۡهُ وَيُبَشِّرَ ٱلۡمُؤۡمِنِينَ

5
00:00:18,860 --> 00:00:24,900
ٱلَّذِينَ يَعۡمَلُونَ ٱلصَّٰلِحَٰتِ أَنَّ لَهُمۡ أَجۡرًا حَسَنٗا ٢

6
00:00:24,900 --> 00:00:27,060
مَّٰكِثِينَ فِيهِ أَبَدٗا ٣

7
00:00:27,060 --> 00:00:32,060
وَيُنذِرَ ٱلَّذِينَ قَالُواْ ٱتَّخَذَ ٱللَّهُ وَلَدٗا ٤

8
00:00:32,060 --> 00:00:38,020
مَّا لَهُم بِهِۦ مِنۡ عِلۡمٖ وَلَا لِأٓبَآئِهِمۡۚ

9
00:00:38,020 --> 00:00:42,440
كَبُرَتۡ كَلِمَةٗ تَخۡرُجُ مِنۡ أَفۡوَٰهِهِمۡۚ

10
00:00:42,440 --> 00:00:45,940
إِن يَقُولُونَ إِلَّا كَذِبٗا ٥

11
00:00:45,940 --> 00:00:50,440
فَلَعَلَّكَ بَٰخِعٞ نَّفۡسَكَ عَلَىٰٓ ءَاثَٰرِهِمۡ إِن

12
00:00:50,440 --> 00:00:53,780
لَّمۡ يُؤۡمِنُواْ بِهَٰذَا ٱلۡحَدِيثِ أَسَفًا ٦

13
00:00:53,780 --> 00:00:57,380
إِنَّا جَعَلۡنَا مَا عَلَى ٱلۡأَرۡضِ زِينَةٗ

14
00:00:57,380 --> 00:01:01,060
لَّهَا لِنَبۡلُوَهُمۡ أَيُّهُمۡ أَحۡسَنُ عَمَلٗا ٧

15
00:01:01,060 --> 00:01:06,660
وَإِنَّا لَجَٰعِلُونَ مَا عَلَيۡهَا صَعِيدٗا جُرُزًا ٨

16
00:01:06,660 --> 00:01:09,640
أَمۡ حَسِبۡتَ أَنَّ أَصۡحَٰبَ ٱلۡكَهۡفِ

17
00:01:09,640 --> 00:01:13,560
وَٱلرَّقِيمِ كَانُواْ مِنۡ ءَايَٰتِنَا عَجَبًا ٩

18
00:01:13,560 --> 00:01:17,960
إِذۡ أَوَى ٱلۡفِتۡيَةُ إِلَى ٱلۡكَهۡفِ فَقَالُواْ رَبَّنَآ ءَاتِنَا

19
00:01:17,960 --> 00:01:23,660
مِن لَّدُنكَ رَحۡمَةٗ وَهَيِّئۡ لَنَا مِنۡ أَمۡرِنَا رَشَدٗا ١٠

20
00:01:23,660 --> 00:01:28,840
فَضَرَبۡنَا عَلَىٰٓ ءَاذَانِهِمۡ فِي ٱلۡكَهۡفِ سِنِينَ عَدَدٗا ١١

21
00:01:28,840 --> 00:01:35,540
ثُمَّ بَعَثۡنَٰهُمۡ لِنَعۡلَمَ أَيُّ ٱلۡحِزۡبَيۡنِ أَحۡصَىٰ لِمَا لَبِثُوٓاْ أَمَدٗا ١٢

22
00:01:35,540 --> 00:01:39,700
نَّحۡنُ نَقُصُّ عَلَيۡكَ نَبَأَهُم بِٱلۡحَقِّۚ

23
00:01:39,700 --> 00:01:45,400
إِنَّهُمۡ فِتۡيَةٌ ءَامَنُواْ بِرَبِّهِمۡ وَزِدۡنَٰهُمۡ هُدٗى ١٣

24
00:01:45,400 --> 00:01:50,500
وَرَبَطۡنَا عَلَىٰ قُلُوبِهِمۡ إِذۡ قَامُواْ فَقَالُواْ رَبُّنَا رَبُّ

25
00:01:50,500 --> 00:01:55,460
ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ لَن نَّدۡعُوَاْ مِن دُونِهِۦٓ إِلَٰهٗاۖ

26
00:01:55,460 --> 00:01:58,540
لَّقَدۡ قُلۡنَآ إِذٗا شَطَطًا ١٤

27
00:01:58,540 --> 00:02:04,760
هَٰٓؤُلَآءِ قَوۡمُنَا ٱتَّخَذُواْ مِن دُونِهِۦٓ ءَالِهَةٗۖ

28
00:02:04,760 --> 00:02:10,420
لَّوۡلَا يَأۡتُونَ عَلَيۡهِم بِسُلۡطَٰنِۭ بَيِّنٖۖ

29
00:02:10,420 --> 00:02:18,160
فَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبٗا ١٥

30
00:02:18,160 --> 00:02:23,720
وَإِذِ ٱعۡتَزَلۡتُمُوهُمۡ وَمَا يَعۡبُدُونَ إِلَّا ٱللَّهَ فَأۡوُۥٓاْ

31
00:02:23,720 --> 00:02:28,820
إِلَى ٱلۡكَهۡفِ يَنشُرۡ لَكُمۡ رَبُّكُم مِّن رَّحۡمَتِهِۦ

32
00:02:28,820 --> 00:02:34,220
وَيُهَيِّئۡ لَكُم مِّنۡ أَمۡرِكُم مِّرۡفَقٗا ١٦

33
00:02:34,220 --> 00:02:39,640
۞ وَتَرَى ٱلشَّمۡسَ إِذَا طَلَعَت تَّزَٰوَرُ عَن كَهۡفِهِمۡ ذَاتَ ٱلۡيَمِينِ

34
00:02:39,640 --> 00:02:46,340
وَإِذَا غَرَبَت تَّقۡرِضُهُمۡ ذَاتَ ٱلشِّمَالِ وَهُمۡ فِي فَجۡوَةٖ مِّنۡهُۚ

35
00:02:46,340 --> 00:02:49,660
ذَٰلِكَ مِنۡ ءَايَٰتِ ٱللَّهِۗ

36
00:02:49,660 --> 00:02:53,200
مَن يَهۡدِ ٱللَّهُ فَهُوَ ٱلۡمُهۡتَدِۖ

37
00:02:53,200 --> 00:02:59,580
وَمَن يُضۡلِلۡ فَلَن تَجِدَ لَهُۥ وَلِيّٗا مُّرۡشِدٗا ١٧

38
00:02:59,580 --> 00:03:04,320
وَتَحۡسَبُهُمۡ أَيۡقَاظٗا وَهُمۡ رُقُودٞۚ

39
00:03:04,320 --> 00:03:08,260
وَنُقَلِّبُهُمۡ ذَاتَ ٱلۡيَمِينِ وَذَاتَ ٱلشِّمَالِۖ

40
00:03:08,260 --> 00:03:13,760
وَكَلۡبُهُم بَٰسِطٞ ذِرَاعَيۡهِ بِٱلۡوَصِيدِۚ

41
00:03:13,760 --> 00:03:21,820
لَوِ ٱطَّلَعۡتَ عَلَيۡهِمۡ لَوَلَّيۡتَ مِنۡهُمۡ فِرَارٗا وَلَمُلِئۡتَ مِنۡهُمۡ رُعۡبٗا ١٨

42
00:03:21,820 --> 00:03:26,980
وَكَذَٰلِكَ بَعَثۡنَٰهُمۡ لِيَتَسَآءَلُواْ بَيۡنَهُمۡۚ

43
00:03:26,980 --> 00:03:31,200
قَالَ قَآئِلٞ مِّنۡهُمۡ كَمۡ لَبِثۡتُمۡۖ

44
00:03:31,200 --> 00:03:35,480
قَالُواْ لَبِثۡنَا يَوۡمًا أَوۡ بَعۡضَ يَوۡمٖۚ

45
00:03:35,480 --> 00:03:41,900
قَالُواْ رَبُّكُمۡ أَعۡلَمُ بِمَا لَبِثۡتُمۡ فَٱبۡعَثُوٓاْ أَحَدَكُم بِوَرِقِكُمۡ

46
00:03:41,900 --> 00:03:53,120
هَٰذِهِۦٓ إِلَى ٱلۡمَدِينَةِ فَلۡيَنظُرۡ أَيُّهَآ أَزۡكَىٰ طَعَامٗا فَلۡيَأۡتِكُم

47
00:03:53,120 --> 00:04:00,440
بِرِزۡقٖ مِّنۡهُ وَلۡيَتَلَطَّفۡ وَلَا يُشۡعِرَنَّ بِكُمۡ أَحَدًا ١٩

48
00:04:00,440 --> 00:04:06,800
إِنَّهُمۡ إِن يَظۡهَرُواْ عَلَيۡكُمۡ يَرۡجُمُوكُمۡ أَوۡ يُعِيدُوكُمۡ

49
00:04:06,800 --> 00:04:11,560
فِي مِلَّتِهِمۡ وَلَن تُفۡلِحُوٓاْ إِذًا أَبَدٗا ٢٠

50
00:04:11,560 --> 00:04:20,440
وَكَذَٰلِكَ أَعۡثَرۡنَا عَلَيۡهِمۡ لِيَعۡلَمُوٓاْ أَنَّ وَعۡدَ ٱللَّهِ حَقّٞ وَأَنَّ

51
00:04:20,440 --> 00:04:25,560
ٱلسَّاعَةَ لَا رَيۡبَ فِيهَآ إِذۡ يَتَنَٰزَعُونَ بَيۡنَهُمۡ أَمۡرَهُمۡۖ

52
00:04:25,560 --> 00:04:29,080
فَقَالُواْ ٱبۡنُواْ عَلَيۡهِم بُنۡيَٰنٗاۖ

53
00:04:29,080 --> 00:04:31,060
رَّبُّهُمۡ أَعۡلَمُ بِهِمۡۚ

54
00:04:31,060 --> 00:04:38,620
قَالَ ٱلَّذِينَ غَلَبُواْ عَلَىٰٓ أَمۡرِهِمۡ لَنَتَّخِذَنَّ عَلَيۡهِم مَّسۡجِدٗا ٢١

55
00:04:38,620 --> 00:04:44,180
سَيَقُولُونَ ثَلَٰثَةٞ رَّابِعُهُمۡ كَلۡبُهُمۡ وَيَقُولُونَ

56
00:04:44,180 --> 00:04:49,820
خَمۡسَةٞ سَادِسُهُمۡ كَلۡبُهُمۡ رَجۡمَۢا بِٱلۡغَيۡبِۖ

57
00:04:49,820 --> 00:04:54,380
وَيَقُولُونَ سَبۡعَةٞ وَثَامِنُهُمۡ كَلۡبُهُمۡۚ

58
00:04:54,380 --> 00:05:01,020
قُل رَّبِّيٓ أَعۡلَمُ بِعِدَّتِهِم مَّا يَعۡلَمُهُمۡ إِلَّا قَلِيلٞۗ

59
00:05:01,020 --> 00:05:06,360
فَلَا تُمَارِ فِيهِمۡ إِلَّا مِرَآءٗ ظَٰهِرٗا

60
00:05:06,360 --> 00:05:11,160
وَلَا تَسۡتَفۡتِ فِيهِم مِّنۡهُمۡ أَحَدٗا ٢٢

61
00:05:11,160 --> 00:05:17,000
وَلَا تَقُولَنَّ لِشَاْيۡءٍ إِنِّي فَاعِلٞ ذَٰلِكَ غَدًا ٢٣

62
00:05:17,000 --> 00:05:21,700
إِلَّآ أَن يَشَآءَ ٱللَّهُۚ

63
00:05:21,700 --> 00:05:26,960
وَٱذۡكُر رَّبَّكَ إِذَا نَسِيتَ وَقُلۡ عَسَىٰٓ أَن

64
00:05:26,960 --> 00:05:31,620
يَهۡدِيَنِ رَبِّي لِأَقۡرَبَ مِنۡ هَٰذَا رَشَدٗا ٢٤

65
00:05:31,620 --> 00:05:39,160
وَلَبِثُواْ فِي كَهۡفِهِمۡ ثَلَٰثَ مِاْئَةٖ سِنِينَ وَٱزۡدَادُواْ تِسۡعٗا ٢٥

66
00:05:39,160 --> 00:05:42,320
قُلِ ٱللَّهُ أَعۡلَمُ بِمَا لَبِثُواْۖ

67
00:05:42,320 --> 00:05:45,540
لَهُۥ غَيۡبُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ

68
00:05:45,540 --> 00:05:48,660
أَبۡصِرۡ بِهِۦ وَأَسۡمِعۡۚ

69
00:05:48,660 --> 00:05:54,140
مَا لَهُم مِّن دُونِهِۦ مِن وَلِيّٖ

70
00:05:54,140 --> 00:06:00,640
وَلَا يُشۡرِكُ فِي حُكۡمِهِۦٓ أَحَدٗا ٢٦

71
00:06:00,640 --> 00:06:05,740
وَٱتۡلُ مَآ أُوحِيَ إِلَيۡكَ مِن كِتَابِ رَبِّكَۖ

72
00:06:05,740 --> 00:06:13,780
لَا مُبَدِّلَ لِكَلِمَٰتِهِۦ وَلَن تَجِدَ مِن دُونِهِۦ مُلۡتَحَدٗا ٢٧

73
00:06:13,780 --> 00:06:17,740
وَٱصۡبِرۡ نَفۡسَكَ مَعَ ٱلَّذِينَ يَدۡعُونَ

74
00:06:17,740 --> 00:06:23,820
رَبَّهُم بِٱلۡغَدَوٰةِ وَٱلۡعَشِيِّ يُرِيدُونَ وَجۡهَهُۥۖ

75
00:06:23,820 --> 00:06:30,660
وَلَا تَعۡدُ عَيۡنَاكَ عَنۡهُمۡ تُرِيدُ زِينَةَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ

76
00:06:30,660 --> 00:06:34,940
وَلَا تُطِعۡ مَنۡ أَغۡفَلۡنَا قَلۡبَهُۥ عَن

77
00:06:34,940 --> 00:06:40,740
ذِكۡرِنَا وَٱتَّبَعَ هَوَىٰهُ وَكَانَ أَمۡرُهُۥ فُرُطٗا ٢٨

78
00:06:40,740 --> 00:06:43,240
وَقُلِ ٱلۡحَقُّ مِن رَّبِّكُمۡۖ

79
00:06:43,240 --> 00:06:51,240
فَمَن شَآءَ فَلۡيُؤۡمِن وَمَن شَآءَ فَلۡيَكۡفُرۡۚ

80
00:06:51,240 --> 00:06:58,240
إِنَّآ أَعۡتَدۡنَا لِلظَّٰلِمِينَ نَارًا أَحَاطَ بِهِمۡ سُرَادِقُهَاۚ

81
00:06:58,240 --> 00:07:15,730
وَإِن يَسۡتَغِيثُواْ يُغَاثُواْ بِمَآءٖ كَٱلۡمُهۡلِ يَشۡوِي ٱلۡوُجُوهَۚ

82
00:07:15,730 --> 00:07:24,620
بِئۡسَ ٱلشَّرَابُ وَسَآءَتۡ مُرۡتَفَقًا ٢٩

83
00:07:24,620 --> 00:07:30,960
إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ إِنَّا

84
00:07:30,960 --> 00:07:34,660
لَا نُضِيعُ أَجۡرَ مَنۡ أَحۡسَنَ عَمَلًا ٣٠

85
00:07:34,660 --> 00:07:42,840
أُوْلَٰٓئِكَ لَهُمۡ جَنَّٰتُ عَدۡنٖ تَجۡرِي مِن تَحۡتِهِمُ ٱلۡأَنۡهَٰرُ

86
00:07:42,840 --> 00:07:52,740
يُحَلَّوۡنَ فِيهَا مِنۡ أَسَاوِرَ مِن ذَهَبٖ وَيَلۡبَسُونَ ثِيَابًا

87
00:07:52,740 --> 00:08:03,240
خُضۡرٗا مِّن سُندُسٖ وَإِسۡتَبۡرَقٖ مُّتَّكِـِٔينَ فِيهَا عَلَى ٱلۡأَرَآئِكِۚ

88
00:08:03,240 --> 00:08:12,660
نِعۡمَ ٱلثَّوَابُ وَحَسُنَتۡ مُرۡتَفَقٗا ٣١

89
00:08:12,660 --> 00:08:19,240
۞ وَٱضۡرِبۡ لَهُم مَّثَلٗا رَّجُلَيۡنِ جَعَلۡنَا لِأَحَدِهِمَا جَنَّتَيۡنِ

90
00:08:19,240 --> 00:08:27,700
مِنۡ أَعۡنَٰبٖ وَحَفَفۡنَٰهُمَا بِنَخۡلٖ وَجَعَلۡنَا بَيۡنَهُمَا زَرۡعٗا ٣٢

91
00:08:27,700 --> 00:08:34,760
كِلۡتَا ٱلۡجَنَّتَيۡنِ ءَاتَتۡ أُكُلَهَا وَلَمۡ تَظۡلِم مِّنۡهُ شَيۡـٔٗاۚ

92
00:08:34,760 --> 00:08:38,320
وَفَجَّرۡنَا خِلَٰلَهُمَا نَهَرٗا ٣٣

93
00:08:38,320 --> 00:08:44,600
وَكَانَ لَهُۥ ثَمَرٞ فَقَالَ لِصَٰحِبِهِۦ وَهُوَ يُحَاوِرُهُۥٓ

94
00:08:44,600 --> 00:08:49,360
أَنَا۠ أَكۡثَرُ مِنكَ مَالٗا وَأَعَزُّ نَفَرٗا ٣٤

95
00:08:49,360 --> 00:08:55,720
وَدَخَلَ جَنَّتَهُۥ وَهُوَ ظَالِمٞ لِّنَفۡسِهِۦ قَالَ

96
00:08:55,720 --> 00:09:00,360
مَآ أَظُنُّ أَن تَبِيدَ هَٰذِهِۦٓ أَبَدٗا ٣٥

97
00:09:00,360 --> 00:09:06,220
وَمَآ أَظُنُّ ٱلسَّاعَةَ قَآئِمَةٗ وَلَئِن رُّدِدتُّ

98
00:09:06,220 --> 00:09:11,360
إِلَىٰ رَبِّي لَأَجِدَنَّ خَيۡرٗا مِّنۡهَا مُنقَلَبٗا ٣٦

99
00:09:11,360 --> 00:09:19,220
قَالَ لَهُۥ صَاحِبُهُۥ وَهُوَ يُحَاوِرُهُۥٓ أَكَفَرۡتَ بِٱلَّذِي خَلَقَكَ

100
00:09:19,220 --> 00:09:26,900
مِن تُرَابٖ ثُمَّ مِن نُّطۡفَةٖ ثُمَّ سَوَّىٰكَ رَجُلٗا ٣٧

101
00:09:26,900 --> 00:09:33,860
لَّٰكِنَّا۠ هُوَ ٱللَّهُ رَبِّي وَلَآ أُشۡرِكُ بِرَبِّيٓ أَحَدٗا ٣٨

102
00:09:33,860 --> 00:09:38,560
وَلَوۡلَآ إِذۡ دَخَلۡتَ جَنَّتَكَ قُلۡتَ مَا

103
00:09:38,560 --> 00:09:44,420
شَآءَ ٱللَّهُ لَا قُوَّةَ إِلَّا بِٱللَّهِۚ

104
00:09:44,420 --> 00:09:49,960
إِن تَرَنِ أَنَا۠ أَقَلَّ مِنكَ مَالٗا وَوَلَدٗا ٣٩

105
00:09:49,960 --> 00:09:55,640
فَعَسَىٰ رَبِّيٓ أَن يُؤۡتِيَنِ خَيۡرٗا مِّن جَنَّتِكَ وَيُرۡسِلَ

106
00:09:55,640 --> 00:10:01,660
عَلَيۡهَا حُسۡبَانٗا مِّنَ ٱلسَّمَآءِ فَتُصۡبِحَ صَعِيدٗا زَلَقًا ٤٠

107
00:10:01,660 --> 00:10:08,680
أَوۡ يُصۡبِحَ مَآؤُهَا غَوۡرٗا فَلَن تَسۡتَطِيعَ لَهُۥ طَلَبٗا ٤١

108
00:10:08,680 --> 00:10:14,100
وَأُحِيطَ بِثَمَرِهِۦ فَأَصۡبَحَ يُقَلِّبُ كَفَّيۡهِ عَلَىٰ مَآ

109
00:10:14,100 --> 00:10:22,040
أَنفَقَ فِيهَا وَهِيَ خَاوِيَةٌ عَلَىٰ عُرُوشِهَا وَيَقُولُ

110
00:10:22,040 --> 00:10:26,840
يَٰلَيۡتَنِي لَمۡ أُشۡرِكۡ بِرَبِّيٓ أَحَدٗا ٤٢

111
00:10:26,840 --> 00:10:32,000
وَلَمۡ تَكُن لَّهُۥ فِئَةٞ يَنصُرُونَهُۥ مِن

112
00:10:32,000 --> 00:10:35,700
دُونِ ٱللَّهِ وَمَا كَانَ مُنتَصِرًا ٤٣

113
00:10:35,700 --> 00:10:40,480
هُنَالِكَ ٱلۡوَلَٰيَةُ لِلَّهِ ٱلۡحَقِّۚ

114
00:10:40,480 --> 00:10:46,640
هُوَ خَيۡرٞ ثَوَابٗا وَخَيۡرٌ عُقۡبٗا ٤٤

115
00:10:46,640 --> 00:10:55,020
وَٱضۡرِبۡ لَهُم مَّثَلَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا كَمَآءٍ أَنزَلۡنَٰهُ مِنَ ٱلسَّمَآءِ

116
00:10:55,020 --> 00:11:02,760
فَٱخۡتَلَطَ بِهِۦ نَبَاتُ ٱلۡأَرۡضِ فَأَصۡبَحَ هَشِيمٗا تَذۡرُوهُ ٱلرِّيَٰحُۗ

117
00:11:02,760 --> 00:11:08,880
وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ مُّقۡتَدِرًا ٤٥

118
00:11:08,880 --> 00:11:21,540
ٱلۡمَالُ وَٱلۡبَنُونَ زِينَةُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ

119
00:11:21,540 --> 00:11:32,420
وَٱلۡبَٰقِيَٰتُ ٱلصَّٰلِحَٰتُ خَيۡرٌ عِندَ رَبِّكَ ثَوَابٗا وَخَيۡرٌ أَمَلٗا ٤٦

120
00:11:32,420 --> 00:11:37,140
وَيَوۡمَ نُسَيِّرُ ٱلۡجِبَالَ وَتَرَى ٱلۡأَرۡضَ بَارِزَةٗ

121
00:11:37,140 --> 00:11:42,720
وَحَشَرۡنَٰهُمۡ فَلَمۡ نُغَادِرۡ مِنۡهُمۡ أَحَدٗا ٤٧

122
00:11:42,720 --> 00:11:45,940
وَعُرِضُواْ عَلَىٰ رَبِّكَ صَفّٗا لَّقَدۡ

123
00:11:45,940 --> 00:11:50,800
جِئۡتُمُونَا كَمَا خَلَقۡنَٰكُمۡ أَوَّلَ مَرَّةِۭۚ

124
00:11:50,800 --> 00:11:56,240
بَلۡ زَعَمۡتُمۡ أَلَّن نَّجۡعَلَ لَكُم مَّوۡعِدٗا ٤٨

125
00:11:56,240 --> 00:12:02,160
وَوُضِعَ ٱلۡكِتَٰبُ فَتَرَى ٱلۡمُجۡرِمِينَ مُشۡفِقِينَ مِمَّا فِيهِ

126
00:12:02,160 --> 00:12:08,720
وَيَقُولُونَ يَٰوَيۡلَتَنَا مَالِ هَٰذَا ٱلۡكِتَٰبِ لَا يُغَادِرُ

127
00:12:08,720 --> 00:12:19,000
صَغِيرَةٗ وَلَا كَبِيرَةً إِلَّآ أَحۡصَىٰهَاۚ

128
00:12:19,000 --> 00:12:22,800
وَوَجَدُواْ مَا عَمِلُواْ حَاضِرٗاۗ

129
00:12:22,800 --> 00:12:27,360
وَلَا يَظۡلِمُ رَبُّكَ أَحَدٗا ٤٩

130
00:12:27,360 --> 00:12:38,300
وَإِذۡ قُلۡنَا لِلۡمَلَٰٓئِكَةِ ٱسۡجُدُواْ لِأٓدَمَ فَسَجَدُوٓاْ إِلَّآ إِبۡلِيسَ

131
00:12:38,300 --> 00:12:42,720
كَانَ مِنَ ٱلۡجِنِّ فَفَسَقَ عَنۡ أَمۡرِ رَبِّهِۦٓۗ

132
00:12:42,720 --> 00:12:51,480
أَفَتَتَّخِذُونَهُۥ وَذُرِّيَّتَهُۥٓ أَوۡلِيَآءَ مِن دُونِي وَهُمۡ لَكُمۡ عَدُوُّۢۚ

133
00:12:51,480 --> 00:12:54,780
بِئۡسَ لِلظَّٰلِمِينَ بَدَلٗا ٥٠

134
00:12:54,780 --> 00:13:00,240
۞ مَّآ أَشۡهَدتُّهُمۡ خَلۡقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَلَا خَلۡقَ

135
00:13:00,240 --> 00:13:06,520
أَنفُسِهِمۡ وَمَا كُنتُ مُتَّخِذَ ٱلۡمُضِلِّينَ عَضُدٗا ٥١

136
00:13:06,520 --> 00:13:12,200
وَيَوۡمَ يَقُولُ نَادُواْ شُرَكَآءِيَ ٱلَّذِينَ زَعَمۡتُمۡ فَدَعَوۡهُمۡ

137
00:13:12,200 --> 00:13:17,760
فَلَمۡ يَسۡتَجِيبُواْ لَهُمۡ وَجَعَلۡنَا بَيۡنَهُم مَّوۡبِقٗا ٥٢

138
00:13:17,760 --> 00:13:23,180
وَرَءَا ٱلۡمُجۡرِمُونَ ٱلنَّارَ فَظَنُّوٓاْ أَنَّهُم

139
00:13:23,180 --> 00:13:28,060
مُّوَاقِعُوهَا وَلَمۡ يَجِدُواْ عَنۡهَا مَصۡرِفٗا ٥٣

140
00:13:28,060 --> 00:13:34,820
وَلَقَدۡ صَرَّفۡنَا فِي هَٰذَا ٱلۡقُرۡءَانِ لِلنَّاسِ مِن كُلِّ مَثَلٖۚ

141
00:13:34,820 --> 00:13:40,080
وَكَانَ ٱلۡإِنسَٰنُ أَكۡثَرَ شَيۡءٖ جَدَلٗا ٥٤

142
00:13:40,080 --> 00:13:46,500
وَمَا مَنَعَ ٱلنَّاسَ أَن يُؤۡمِنُوٓاْ إِذۡ جَآءَهُمُ

143
00:13:46,500 --> 00:13:53,360
ٱلۡهُدَىٰ وَيَسۡتَغۡفِرُواْ رَبَّهُمۡ إِلَّآ أَن تَأۡتِيَهُمۡ سُنَّةُ

144
00:13:53,360 --> 00:14:00,780
ٱلۡأَوَّلِينَ أَوۡ يَأۡتِيَهُمُ ٱلۡعَذَابُ قُبُلٗا ٥٥

145
00:14:00,780 --> 00:14:07,520
وَمَا نُرۡسِلُ ٱلۡمُرۡسَلِينَ إِلَّا مُبَشِّرِينَ وَمُنذِرِينَۚ

146
00:14:07,520 --> 00:14:13,680
وَيُجَٰدِلُ ٱلَّذِينَ كَفَرُواْ بِٱلۡبَٰطِلِ لِيُدۡحِضُواْ بِهِ ٱلۡحَقَّۖ

147
00:14:13,680 --> 00:14:19,780
وَٱتَّخَذُوٓاْ ءَايَٰتِي وَمَآ أُنذِرُواْ هُزُوٗا ٥٦

148
00:14:19,780 --> 00:14:25,000
وَمَنۡ أَظۡلَمُ مِمَّن ذُكِّرَ بِـَٔايَٰتِ رَبِّهِۦ

149
00:14:25,000 --> 00:14:30,120
فَأَعۡرَضَ عَنۡهَا وَنَسِيَ مَا قَدَّمَتۡ يَدَاهُۚ

150
00:14:30,120 --> 00:14:34,360
إِنَّا جَعَلۡنَا عَلَىٰ قُلُوبِهِمۡ أَكِنَّةً

151
00:14:34,360 --> 00:14:38,300
أَن يَفۡقَهُوهُ وَفِيٓ ءَاذَانِهِمۡ وَقۡرٗاۖ

152
00:14:38,300 --> 00:14:44,760
وَإِن تَدۡعُهُمۡ إِلَى ٱلۡهُدَىٰ فَلَن يَهۡتَدُوٓاْ إِذًا أَبَدٗا ٥٧

153
00:14:44,760 --> 00:14:51,720
وَرَبُّكَ ٱلۡغَفُورُ ذُو ٱلرَّحۡمَةِۖ

154
00:14:51,720 --> 00:14:57,800
لَوۡ يُؤَاخِذُهُم بِمَا كَسَبُواْ لَعَجَّلَ لَهُمُ ٱلۡعَذَابَۚ

155
00:14:57,800 --> 00:15:05,280
بَل لَّهُم مَّوۡعِدٞ لَّن يَجِدُواْ مِن دُونِهِۦ مَوۡئِلٗا ٥٨

156
00:15:05,280 --> 00:15:13,100
وَتِلۡكَ ٱلۡقُرَىٰٓ أَهۡلَكۡنَٰهُمۡ لَمَّا ظَلَمُواْ وَجَعَلۡنَا لِمَهۡلِكِهِم مَّوۡعِدٗا ٥٩

157
00:15:13,100 --> 00:15:17,280
وَإِذۡ قَالَ مُوسَىٰ لِفَتَىٰهُ لَآ أَبۡرَحُ حَتَّىٰٓ

158
00:15:17,280 --> 00:15:22,060
أَبۡلُغَ مَجۡمَعَ ٱلۡبَحۡرَيۡنِ أَوۡ أَمۡضِيَ حُقُبٗا ٦٠

159
00:15:22,060 --> 00:15:27,540
فَلَمَّا بَلَغَا مَجۡمَعَ بَيۡنِهِمَا نَسِيَا حُوتَهُمَا

160
00:15:27,540 --> 00:15:31,260
فَٱتَّخَذَ سَبِيلَهُۥ فِي ٱلۡبَحۡرِ سَرَبٗا ٦١

161
00:15:31,260 --> 00:15:38,040
فَلَمَّا جَاوَزَا قَالَ لِفَتَىٰهُ ءَاتِنَا غَدَآءَنَا

162
00:15:38,040 --> 00:15:42,660
لَقَدۡ لَقِينَا مِن سَفَرِنَا هَٰذَا نَصَبٗا ٦٢

163
00:15:42,660 --> 00:15:48,400
قَالَ أَرَءَيۡتَ إِذۡ أَوَيۡنَآ إِلَى ٱلصَّخۡرَةِ فَإِنِّي نَسِيتُ

164
00:15:48,400 --> 00:15:54,260
ٱلۡحُوتَ وَمَآ أَنسَىٰنِيهُ إِلَّا ٱلشَّيۡطَٰنُ أَنۡ أَذۡكُرَهُۥۚ

165
00:15:54,260 --> 00:15:58,480
وَٱتَّخَذَ سَبِيلَهُۥ فِي ٱلۡبَحۡرِ عَجَبٗا ٦٣

166
00:15:58,480 --> 00:16:01,720
قَالَ ذَٰلِكَ مَا كُنَّا نَبۡغِۚ

167
00:16:01,720 --> 00:16:07,000
فَٱرۡتَدَّا عَلَىٰٓ ءَاثَارِهِمَا قَصَصٗا ٦٤

168
00:16:07,000 --> 00:16:12,580
فَوَجَدَا عَبۡدٗا مِّنۡ عِبَادِنَآ ءَاتَيۡنَٰهُ رَحۡمَةٗ

169
00:16:12,580 --> 00:16:17,460
مِّنۡ عِندِنَا وَعَلَّمۡنَٰهُ مِن لَّدُنَّا عِلۡمٗا ٦٥

170
00:16:17,460 --> 00:16:21,380
قَالَ لَهُۥ مُوسَىٰ هَلۡ أَتَّبِعُكَ عَلَىٰٓ

171
00:16:21,380 --> 00:16:25,680
أَن تُعَلِّمَنِ مِمَّا عُلِّمۡتَ رُشۡدٗا ٦٦

172
00:16:25,680 --> 00:16:30,940
قَالَ إِنَّكَ لَن تَسۡتَطِيعَ مَعِيَ صَبۡرٗا ٦٧

173
00:16:30,940 --> 00:16:35,740
وَكَيۡفَ تَصۡبِرُ عَلَىٰ مَا لَمۡ تُحِطۡ بِهِۦ خُبۡرٗا ٦٨

174
00:16:35,740 --> 00:16:40,900
قَالَ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ

175
00:16:40,900 --> 00:16:44,560
صَابِرٗا وَلَآ أَعۡصِي لَكَ أَمۡرٗا ٦٩

176
00:16:44,560 --> 00:16:49,760
قَالَ فَإِنِ ٱتَّبَعۡتَنِي فَلَا تَسۡـَٔلۡنِي عَن

177
00:16:49,760 --> 00:16:54,540
شَيۡءٍ حَتَّىٰٓ أُحۡدِثَ لَكَ مِنۡهُ ذِكۡرٗا ٧٠

178
00:16:57,880 --> 00:17:03,660
فَٱنطَلَقَا حَتَّىٰٓ إِذَا رَكِبَا فِي ٱلسَّفِينَةِ خَرَقَهَاۖ

179
00:17:03,660 --> 00:17:10,760
قَالَ أَخَرَقۡتَهَا لِتُغۡرِقَ أَهۡلَهَا لَقَدۡ جِئۡتَ شَيۡـًٔا إِمۡرٗا ٧١

180
00:17:10,760 --> 00:17:17,320
قَالَ أَلَمۡ أَقُلۡ إِنَّكَ لَن تَسۡتَطِيعَ مَعِيَ صَبۡرٗا ٧٢

181
00:17:17,320 --> 00:17:21,020
قَالَ لَا تُؤَاخِذۡنِي بِمَا نَسِيتُ

182
00:17:21,020 --> 00:17:27,700
وَلَا تُرۡهِقۡنِي مِنۡ أَمۡرِي عُسۡرٗا ٧٣

183
00:17:27,700 --> 00:17:35,300
فَٱنطَلَقَا حَتَّىٰٓ إِذَا لَقِيَا غُلَٰمٗا فَقَتَلَهُۥ قَالَ أَقَتَلۡتَ

184
00:17:35,300 --> 00:17:44,080
نَفۡسٗا زَكِيَّةَۢ بِغَيۡرِ نَفۡسٖ لَّقَدۡ جِئۡتَ شَيۡـٔٗا نُّكۡرٗا ٧٤

185
00:17:44,080 --> 00:17:51,680
۞ قَالَ أَلَمۡ أَقُل لَّكَ إِنَّكَ لَن تَسۡتَطِيعَ مَعِيَ صَبۡرٗا ٧٥

186
00:17:51,680 --> 00:17:58,860
قَالَ إِن سَأَلۡتُكَ عَن شَيۡءِۭ بَعۡدَهَا فَلَا تُصَٰحِبۡنِيۖ

187
00:17:58,860 --> 00:18:03,460
قَدۡ بَلَغۡتَ مِن لَّدُنِّي عُذۡرٗا ٧٦

188
00:18:03,460 --> 00:18:11,720
فَٱنطَلَقَا حَتَّىٰٓ إِذَآ أَتَيَآ أَهۡلَ قَرۡيَةٍ ٱسۡتَطۡعَمَآ أَهۡلَهَا فَأَبَوۡاْ

189
00:18:11,720 --> 00:18:20,700
أَن يُضَيِّفُوهُمَا فَوَجَدَا فِيهَا جِدَارٗا يُرِيدُ أَن يَنقَضَّ فَأَقَامَهُۥۖ

190
00:18:20,700 --> 00:18:24,580
قَالَ لَوۡ شِئۡتَ لَتَّخَذۡتَ عَلَيۡهِ أَجۡرٗا ٧٧

191
00:18:24,580 --> 00:18:29,140
قَالَ هَٰذَا فِرَاقُ بَيۡنِي وَبَيۡنِكَۚ

192
00:18:29,140 --> 00:18:34,600
سَأُنَبِّئُكَ بِتَأۡوِيلِ مَا لَمۡ تَسۡتَطِع عَّلَيۡهِ صَبۡرًا ٧٨

193
00:18:34,600 --> 00:18:43,100
أَمَّا ٱلسَّفِينَةُ فَكَانَتۡ لِمَسَٰكِينَ يَعۡمَلُونَ فِي ٱلۡبَحۡرِ فَأَرَدتُّ أَنۡ

194
00:18:43,100 --> 00:18:50,580
أَعِيبَهَا وَكَانَ وَرَآءَهُم مَّلِكٞ يَأۡخُذُ كُلَّ سَفِينَةٍ غَصۡبٗا ٧٩

195
00:18:50,580 --> 00:18:56,380
وَأَمَّا ٱلۡغُلَٰمُ فَكَانَ أَبَوَاهُ مُؤۡمِنَيۡنِ

196
00:18:56,380 --> 00:19:02,160
فَخَشِينَآ أَن يُرۡهِقَهُمَا طُغۡيَٰنٗا وَكُفۡرٗا ٨٠

197
00:19:02,160 --> 00:19:09,980
فَأَرَدۡنَآ أَن يُبۡدِلَهُمَا رَبُّهُمَا خَيۡرٗا مِّنۡهُ زَكَوٰةٗ وَأَقۡرَبَ رُحۡمٗا ٨١

198
00:19:09,980 --> 00:19:17,980
وَأَمَّا ٱلۡجِدَارُ فَكَانَ لِغُلَٰمَيۡنِ يَتِيمَيۡنِ فِي ٱلۡمَدِينَةِ وَكَانَ

199
00:19:17,980 --> 00:19:25,720
تَحۡتَهُۥ كَنزٞ لَّهُمَا وَكَانَ أَبُوهُمَا صَٰلِحٗا فَأَرَادَ رَبُّكَ

200
00:19:25,720 --> 00:19:39,520
أَن يَبۡلُغَآ أَشُدَّهُمَا وَيَسۡتَخۡرِجَا كَنزَهُمَا رَحۡمَةٗ مِّن رَّبِّكَۚ

201
00:19:39,520 --> 00:19:43,280
وَمَا فَعَلۡتُهُۥ عَنۡ أَمۡرِيۚ

202
00:19:43,280 --> 00:19:52,700
ذَٰلِكَ تَأۡوِيلُ مَا لَمۡ تَسۡطِع عَّلَيۡهِ صَبۡرٗا ٨٢

203
00:19:52,700 --> 00:19:56,580
وَيَسۡـَٔلُونَكَ عَن ذِي ٱلۡقَرۡنَيۡنِۖ

204
00:19:56,580 --> 00:20:00,620
قُلۡ سَأَتۡلُواْ عَلَيۡكُم مِّنۡهُ ذِكۡرًا ٨٣

205
00:20:00,620 --> 00:20:04,480
إِنَّا مَكَّنَّا لَهُۥ فِي ٱلۡأَرۡضِ

206
00:20:04,480 --> 00:20:09,200
وَءَاتَيۡنَٰهُ مِن كُلِّ شَيۡءٖ سَبَبٗا ٨٤

207
00:20:09,200 --> 00:20:11,560
فَأَتۡبَعَ سَبَبًا ٨٥

208
00:20:11,560 --> 00:20:16,300
حَتَّىٰٓ إِذَا بَلَغَ مَغۡرِبَ ٱلشَّمۡسِ وَجَدَهَا تَغۡرُبُ

209
00:20:16,300 --> 00:20:21,820
فِي عَيۡنٍ حَمِئَةٖ وَوَجَدَ عِندَهَا قَوۡمٗاۖ

210
00:20:21,820 --> 00:20:27,560
قُلۡنَا يَٰذَا ٱلۡقَرۡنَيۡنِ إِمَّآ أَن تُعَذِّبَ

211
00:20:27,560 --> 00:20:31,800
وَإِمَّآ أَن تَتَّخِذَ فِيهِمۡ حُسۡنٗا ٨٦

212
00:20:31,800 --> 00:20:37,300
قَالَ أَمَّا مَن ظَلَمَ فَسَوۡفَ نُعَذِّبُهُۥ ثُمَّ

213
00:20:37,300 --> 00:20:42,760
يُرَدُّ إِلَىٰ رَبِّهِۦ فَيُعَذِّبُهُۥ عَذَابٗا نُّكۡرٗا ٨٧

214
00:20:42,760 --> 00:20:50,200
وَأَمَّا مَنۡ ءَامَنَ وَعَمِلَ صَٰلِحٗا فَلَهُۥ جَزَآءً ٱلۡحُسۡنَىٰۖ

215
00:20:50,200 --> 00:20:54,360
وَسَنَقُولُ لَهُۥ مِنۡ أَمۡرِنَا يُسۡرٗا ٨٨

216
00:20:54,360 --> 00:20:57,700
ثُمَّ أَتۡبَعَ سَبَبًا ٨٩

217
00:20:57,700 --> 00:21:03,040
حَتَّىٰٓ إِذَا بَلَغَ مَطۡلِعَ ٱلشَّمۡسِ وَجَدَهَا تَطۡلُعُ عَلَىٰ

218
00:21:03,040 --> 00:21:07,740
قَوۡمٖ لَّمۡ نَجۡعَل لَّهُم مِّن دُونِهَا سِتۡرٗا ٩٠

219
00:21:07,740 --> 00:21:13,220
كَذَٰلِكَۖ وَقَدۡ أَحَطۡنَا بِمَا لَدَيۡهِ خُبۡرٗا ٩١

220
00:21:13,220 --> 00:21:16,800
ثُمَّ أَتۡبَعَ سَبَبًا ٩٢

221
00:21:16,800 --> 00:21:21,140
حَتَّىٰٓ إِذَا بَلَغَ بَيۡنَ ٱلسَّدَّيۡنِ وَجَدَ مِن

222
00:21:21,140 --> 00:21:26,140
دُونِهِمَا قَوۡمٗا لَّا يَكَادُونَ يَفۡقَهُونَ قَوۡلٗا ٩٣

223
00:21:26,140 --> 00:21:31,880
قَالُواْ يَٰذَا ٱلۡقَرۡنَيۡنِ إِنَّ يَأۡجُوجَ وَمَأۡجُوجَ مُفۡسِدُونَ

224
00:21:31,880 --> 00:21:35,360
فِي ٱلۡأَرۡضِ فَهَلۡ نَجۡعَلُ لَكَ خَرۡجًا عَلَىٰٓ

225
00:21:35,360 --> 00:21:39,320
أَن تَجۡعَلَ بَيۡنَنَا وَبَيۡنَهُمۡ سَدّٗا ٩٤

226
00:21:39,320 --> 00:21:43,580
قَالَ مَا مَكَّنِّي فِيهِ رَبِّي خَيۡرٞ

227
00:21:43,580 --> 00:21:49,520
فَأَعِينُونِي بِقُوَّةٍ أَجۡعَلۡ بَيۡنَكُمۡ وَبَيۡنَهُمۡ رَدۡمًا ٩٥

228
00:21:49,520 --> 00:21:53,100
ءَاتُونِي زُبَرَ ٱلۡحَدِيدِۖ

229
00:21:53,100 --> 00:21:58,500
حَتَّىٰٓ إِذَا سَاوَىٰ بَيۡنَ ٱلصَّدَفَيۡنِ قَالَ ٱنفُخُواْۖ

230
00:21:58,500 --> 00:22:05,600
حَتَّىٰٓ إِذَا جَعَلَهُۥ نَارٗا قَالَ ءَاتُونِيٓ أُفۡرِغۡ عَلَيۡهِ قِطۡرٗا ٩٦

231
00:22:05,600 --> 00:22:13,840
فَمَا ٱسۡطَٰعُوٓاْ أَن يَظۡهَرُوهُ وَمَا ٱسۡتَطَٰعُواْ لَهُۥ نَقۡبٗا ٩٧

232
00:22:13,840 --> 00:22:17,560
قَالَ هَٰذَا رَحۡمَةٞ مِّن رَّبِّيۖ

233
00:22:17,560 --> 00:22:25,560
فَإِذَا جَآءَ وَعۡدُ رَبِّي جَعَلَهُۥ دَكَّآءَۖ

234
00:22:25,560 --> 00:22:28,640
وَكَانَ وَعۡدُ رَبِّي حَقّٗا ٩٨

235
00:22:28,640 --> 00:22:33,520
۞ وَتَرَكۡنَا بَعۡضَهُمۡ يَوۡمَئِذٖ يَمُوجُ فِي بَعۡضٖۖ

236
00:22:33,520 --> 00:22:38,080
وَنُفِخَ فِي ٱلصُّورِ فَجَمَعۡنَٰهُمۡ جَمۡعٗا ٩٩

237
00:22:38,080 --> 00:22:44,280
وَعَرَضۡنَا جَهَنَّمَ يَوۡمَئِذٖ لِّلۡكَٰفِرِينَ عَرۡضًا ١٠٠

238
00:22:44,280 --> 00:22:49,580
ٱلَّذِينَ كَانَتۡ أَعۡيُنُهُمۡ فِي غِطَآءٍ عَن

239
00:22:49,580 --> 00:22:54,580
ذِكۡرِي وَكَانُواْ لَا يَسۡتَطِيعُونَ سَمۡعًا ١٠١

240
00:22:54,580 --> 00:23:03,600
أَفَحَسِبَ ٱلَّذِينَ كَفَرُوٓاْ أَن يَتَّخِذُواْ عِبَادِي مِن دُونِيٓ أَوۡلِيَآءَۚ

241
00:23:03,600 --> 00:23:12,400
إِنَّآ أَعۡتَدۡنَا جَهَنَّمَ لِلۡكَٰفِرِينَ نُزُلٗا ١٠٢

242
00:23:12,400 --> 00:23:18,680
قُلۡ هَلۡ نُنَبِّئُكُم بِٱلۡأَخۡسَرِينَ أَعۡمَٰلًا ١٠٣

243
00:23:18,680 --> 00:23:22,960
ٱلَّذِينَ ضَلَّ سَعۡيُهُمۡ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا

244
00:23:22,960 --> 00:23:28,340
وَهُمۡ يَحۡسَبُونَ أَنَّهُمۡ يُحۡسِنُونَ صُنۡعًا ١٠٤

245
00:23:28,340 --> 00:23:35,600
أُوْلَٰٓئِكَ ٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِ رَبِّهِمۡ وَلِقَآئِهِۦ فَحَبِطَتۡ

246
00:23:35,600 --> 00:23:40,980
أَعۡمَٰلُهُمۡ فَلَا نُقِيمُ لَهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ وَزۡنٗا ١٠٥

247
00:23:40,980 --> 00:23:52,420
ذَٰلِكَ جَزَآؤُهُمۡ جَهَنَّمُ بِمَا كَفَرُواْ وَٱتَّخَذُوٓاْ ءَايَٰتِي وَرُسُلِي هُزُوًا ١٠٦

248
00:23:52,420 --> 00:23:59,240
إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ

249
00:23:59,240 --> 00:24:04,920
كَانَتۡ لَهُمۡ جَنَّٰتُ ٱلۡفِرۡدَوۡسِ نُزُلًا ١٠٧

250
00:24:04,920 --> 00:24:10,760
خَٰلِدِينَ فِيهَا لَا يَبۡغُونَ عَنۡهَا حِوَلٗا ١٠٨

251
00:24:10,760 --> 00:24:17,440
قُل لَّوۡ كَانَ ٱلۡبَحۡرُ مِدَادٗا لِّكَلِمَٰتِ رَبِّي لَنَفِدَ ٱلۡبَحۡرُ

252
00:24:17,440 --> 00:24:25,440
قَبۡلَ أَن تَنفَدَ كَلِمَٰتُ رَبِّي وَلَوۡ جِئۡنَا بِمِثۡلِهِۦ مَدَدٗا ١٠٩

253
00:24:25,440 --> 00:24:31,100
قُلۡ إِنَّمَآ أَنَا۠ بَشَرٞ مِّثۡلُكُمۡ يُوحَىٰٓ

254
00:24:31,100 --> 00:24:36,540
إِلَيَّ أَنَّمَآ إِلَٰهُكُمۡ إِلَٰهٞ وَٰحِدٞۖ

255
00:24:36,540 --> 00:24:45,580
فَمَن كَانَ يَرۡجُواْ لِقَآءَ رَبِّهِۦ فَلۡيَعۡمَلۡ عَمَلٗا

256
00:24:45,580 --> 00:24:55,200
صَٰلِحٗا وَلَا يُشۡرِكۡ بِعِبَادَةِ رَبِّهِۦٓ أَحَدَۢا ١١٠

